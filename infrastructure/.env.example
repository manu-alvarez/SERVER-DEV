# MSBrossAI — Infrastructure Environment Template
# Copy to .env.production on VPS and fill in real values
# Load with: export $(cat infrastructure/.env.production | xargs)

# Traefik
TRAEFIK_DASHBOARD_AUTH=admin:$(openssl passwd -apr1 YOUR_PASSWORD)
ACME_EMAIL=admin@example.com

# Proxy Auth Token (protects /__health and /__config)
ADMIN_API_TOKEN=your-secure-random-token-here

# PostgreSQL (shared across services)
POSTGRES_PASSWORD=your-postgres-password

# MinIO
MINIO_ROOT_PASSWORD=your-minio-password
