# LiteLLM Proxy - Environment Variables
# Copy this file to .env and fill in your real keys
# NEVER commit .env to git

# Master key for LiteLLM admin operations (generate a strong random key)
LITELLM_MASTER_KEY=sk-litellm-master-$(openssl rand -hex 32)

# API key that apps will use to call LiteLLM (can be the same as master or a separate one)
LITELLM_API_KEY=sk-litellm-proxy-$(openssl rand -hex 32)

# Provider API Keys
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AQ...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...
DEEPSEEK_API_KEY=sk-...
NVIDIA_API_KEY=nvapi-...
MINIMAX_API_KEY=sk-cp-...
HUGGINGFACE_API_KEY=hf_...
TOGETHER_API_KEY=...
CEREBRAS_API_KEY=csk-...
SILICONFLOW_API_KEY=sk-...
DEEPINFRA_API_KEY=...
OPENCODE_ZEN_API_KEY=sk-...
XIAOMI_MIMO_API_KEY=sk-...
