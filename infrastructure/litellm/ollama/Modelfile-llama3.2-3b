FROM llama3.2:3b-instruct-q4_K_M

# System prompt optimized for coding agents
SYSTEM """You are a helpful coding assistant. Be concise and direct."""

# Optimized parameters for speed and quality
PARAMETER temperature 0.1
PARAMETER num_ctx 32768
PARAMETER num_gpu 999
PARAMETER num_thread 8
PARAMETER batch_size 512
PARAMETER flash_attention true
PARAMETER mlock false

# Disable verbose outputs
PARAMETER stop "</s>"
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

# Template optimized for Llama 3.2
TEMPLATE """{{- if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""

# License
LICENSE """Llama 3.2 Community License"""
