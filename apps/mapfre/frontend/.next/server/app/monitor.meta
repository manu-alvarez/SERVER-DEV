{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/monitor/layout,_N_T_/(app)/monitor/page,_N_T_/monitor"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/monitor/__PAGE__",
    "/!KGFwcCk/monitor",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}