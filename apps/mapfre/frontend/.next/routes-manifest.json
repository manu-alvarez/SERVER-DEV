{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "/app/mapfre",
  "redirects": [
    {
      "source": "/app/mapfre/",
      "destination": "/app/mapfre",
      "basePath": false,
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^/app/mapfre/$"
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/expedientes/[id]",
      "regex": "^/api/expedientes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/expedientes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/expedientes/[id]",
      "regex": "^/expedientes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/expedientes/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/ajustes",
      "regex": "^/ajustes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ajustes(?:/)?$"
    },
    {
      "page": "/api/dashboard",
      "regex": "^/api/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/dashboard(?:/)?$"
    },
    {
      "page": "/api/expedientes",
      "regex": "^/api/expedientes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/expedientes(?:/)?$"
    },
    {
      "page": "/api/run",
      "regex": "^/api/run(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/run(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/expedientes",
      "regex": "^/expedientes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/expedientes(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/monitor",
      "regex": "^/monitor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/monitor(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}