# Cuentos Mágicos - Environment Template
# Copy to .env and fill in real values
# WARNING: Never commit .env files to git

# Backend
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/cuentos_magicos"
REDIS_URL="redis://localhost:6379/0"
OPENAI_API_KEY="sk-your-openai-key"
GOOGLE_API_KEY="your-google-api-key"
GROQ_API_KEY="gsk-your-groq-key"
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
HUGGINGFACE_TOKEN="hf_your-token"

# Frontend (Next.js)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_API_BASE_URL="/_cuentosmagicos"
NEXT_PUBLIC_BASE_PATH="/app/cuentos-magicos"
